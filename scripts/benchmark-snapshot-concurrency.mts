await writeFile(baseline,execFileSync('git',['show','043af2e:apps/worker/src/full-snapshot.ts'],{cwd:root}),{flag:'wx',mode:0o600});
const old=await import(pathToFileURL(baseline).href),current=await import('../apps/worker/src/full-snapshot.ts');
