# Copy to .env at repository root. No credentials are required in demo mode.
PORT=3001
HOST=127.0.0.1
# Exact parent origins allowed to embed the app; space-separated. Never use * in production.
FRAME_ANCESTORS='http://localhost:5173 http://127.0.0.1:5173'
DATA_MODE=demo
LSPORTS_ENVIRONMENT=Test
LSPORTS_PREMATCH_PACKAGE_ID=4511
LSPORTS_INPLAY_PACKAGE_ID=4510
WORKER_POLL_INTERVAL_MS=30000
# Real integration is deliberately unavailable in this stage.
# Configure future provider credentials only on the server, never as VITE_* variables.
