# Server-side only. Copy to .env in repository root; never commit .env.
PORT=3001
HOST=127.0.0.1
FRAME_ANCESTORS='http://localhost:5173 http://127.0.0.1:5173'
# demo | connected. Connected never uses demo fallback.
DATA_MODE=demo
LSPORTS_ENVIRONMENT=Test
LSPORTS_PREMATCH_PACKAGE_ID=4511
LSPORTS_INPLAY_PACKAGE_ID=4510
LSPORTS_PREMATCH_HOST=stm-prematch.lsports.eu
LSPORTS_INPLAY_HOST=stm-inplay.lsports.eu
LSPORTS_SNAPSHOT_URL=https://stm-snapshot.lsports.eu
LSPORTS_CUSTOMERS_URL=https://stm-api.lsports.eu
# Fill separately for each package with the credentials supplied by LSports.
LSPORTS_PREMATCH_USERNAME=
LSPORTS_PREMATCH_PASSWORD=
LSPORTS_INPLAY_USERNAME=
LSPORTS_INPLAY_PASSWORD=
# Official SDK sample uses AMQP 5672, TLS false; confirm your Test package listener.
# For provider-confirmed AMQPS, set true and the provider-confirmed TLS port (usually 5671).
LSPORTS_MQ_TLS=false
LSPORTS_MQ_PORT=5672
# Defaults confirmed in SDK: vhosts StmPreMatch / StmInPlay; queues _4511_ / _4510_.
# Official queues for the package IDs above: BOTH leading and trailing underscores are required.
# Empty values use the SDK default _{packageId}_. Override only for a provider-assigned custom queue.
LSPORTS_PREMATCH_QUEUE=_4511_
LSPORTS_INPLAY_QUEUE=_4510_
LSPORTS_SNAPSHOT_INTERVAL_MS=300000
# Regular PreMatch/InPlay HTTP snapshot response (MiB), integer 1..256.
# Outright retains 50 MiB. Limits apply after decompression.
# Requires heap headroom >= cap * 8 + 64 MiB before requesting.
# Legacy variable is a PreMatch-only fallback; it no longer changes InPlay.
LSPORTS_SNAPSHOT_MAX_RESPONSE_MB=128
LSPORTS_PREMATCH_SNAPSHOT_MAX_RESPONSE_MB=128
LSPORTS_INPLAY_SNAPSHOT_MAX_RESPONSE_MB=128
LSPORTS_FEED_STALE_MS=90000
# Both processes resolve this from repository root, independent of working directory.
LSPORTS_STATE_FILE=.runtime/trade-feed.json
WORKER_POLL_INTERVAL_MS=30000
# Never use VITE_* for provider credentials.
# Optional overrides ONLY if LSports assigned a different RabbitMQ pair or vhost.
# Empty MQ pair reuses the corresponding package HTTP username/password, as in SDK samples.
LSPORTS_PREMATCH_MQ_USERNAME=
LSPORTS_PREMATCH_MQ_PASSWORD=
LSPORTS_INPLAY_MQ_USERNAME=
LSPORTS_INPLAY_MQ_PASSWORD=
LSPORTS_PREMATCH_VHOST=StmPreMatch
LSPORTS_INPLAY_VHOST=StmInPlay
# Local saved-feed evidence (NO supplier requests): npm run diagnose:feed:local
# HTTP/AMQP diagnostics (does not start distribution or consume events): npm run diagnose:trade
# Optional. Relative to repository root in BOTH API and worker. Never use different paths.
# Default: test-tickets.sqlite beside LSPORTS_STATE_FILE. Test points only, no wallet.
# TEST_TICKETS_DB=.runtime/test-tickets.sqlite

# Independent commercial platform foundation (simulation only).
# false preserves the existing local sportsbook and its two legacy tickets.
# true requires bootstrap, authenticates API access, and isolates new clients.
PLATFORM_ENABLED=false
PLATFORM_PUBLIC_ORIGIN=http://localhost:3001
PLATFORM_DATA_DIR=.runtime/platform
# Server-only, used once by npm run platform:bootstrap. Remove password after use.
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
