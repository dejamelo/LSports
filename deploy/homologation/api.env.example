# Copy to api.env on the staging host only. Never put provider credentials here.
# Replace BOTH placeholders with your chosen DNS name; no trailing slash in origin.
HOMOLOGATION_HOST=sportsbook-stage.example.invalid
PLATFORM_PUBLIC_ORIGIN=https://sportsbook-stage.example.invalid
# Set to your administrative VPN/egress CIDRs before exposing the panel.
# Leave this restrictive value until the administrator's network is known.
ADMIN_ALLOWED_CIDRS=127.0.0.1/32 ::1/128
