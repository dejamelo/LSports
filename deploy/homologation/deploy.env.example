# Non-secret Compose interpolation only. Keep actual values on the AWS host.
COMPOSE_PROJECT_NAME=adl-homologation
ADL_IMAGE=adl-homologation:review
ADL_API_LOOPBACK_PORT=13001
ADL_API_MEMORY_LIMIT=768m
ADL_API_CPUS=0.5
ADL_WORKER_MEMORY_LIMIT=4g
ADL_WORKER_CPUS=2.0
ADL_PREMATCH_SNAPSHOT_MB=256
ADL_INPLAY_SNAPSHOT_MB=128
# Leave NO until host capacity and the actual Mac shutdown are verified.
ADL_CAPACITY_APPROVED=no
ADL_MAC_WORKER_STOPPED=no
# UTC barrier >= all existing retryAt and last successful operation + refresh interval.
ADL_SUPPLIER_NOT_BEFORE_UTC=
HOMOLOGATION_HOST=sportsbook-stage.example.invalid
ADMIN_ALLOWED_CIDRS=127.0.0.1/32 ::1/128
# Only when using compose.existing-caddy.yaml; must already exist.
ADL_CADDY_NETWORK=
# Put protected files outside the checkout on AWS, chmod 600.
API_ENV_FILE=/etc/adl-homologation/api.env
WORKER_ENV_FILE=/etc/adl-homologation/worker.env
