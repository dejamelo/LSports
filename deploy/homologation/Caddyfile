{$HOMOLOGATION_HOST} {
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
  @privateAdmin {
    path /control /api/control/*
    not remote_ip {$ADMIN_ALLOWED_CIDRS}
  }
  respond @privateAdmin 403
  @developmentOnly path /demo/* /local-demo/* /synthetic/*
  respond @developmentOnly 404
  reverse_proxy api:3001
  # Intentionally no access logging of session URLs or request headers/bodies.
  # frame-ancestors is generated by the application per authenticated client.
}
