# Copy to worker.env on the staging host only; chmod 600. Do not copy the Mac .env.
LSPORTS_PREMATCH_PACKAGE_ID=4511
LSPORTS_INPLAY_PACKAGE_ID=4510
LSPORTS_PREMATCH_HOST=stm-prematch.lsports.eu
LSPORTS_INPLAY_HOST=stm-inplay.lsports.eu
LSPORTS_SNAPSHOT_URL=https://stm-snapshot.lsports.eu
LSPORTS_CUSTOMERS_URL=https://stm-api.lsports.eu
LSPORTS_PREMATCH_USERNAME=
LSPORTS_PREMATCH_PASSWORD=
LSPORTS_INPLAY_USERNAME=
LSPORTS_INPLAY_PASSWORD=
LSPORTS_MQ_TLS=false
LSPORTS_MQ_PORT=5672
LSPORTS_PREMATCH_VHOST=StmPreMatch
LSPORTS_INPLAY_VHOST=StmInPlay
LSPORTS_PREMATCH_QUEUE=_4511_
LSPORTS_INPLAY_QUEUE=_4510_
LSPORTS_SNAPSHOT_INTERVAL_MS=300000
LSPORTS_FEED_STALE_MS=90000
# Optional MQ credentials ONLY if supplier explicitly assigned a distinct pair.
LSPORTS_PREMATCH_MQ_USERNAME=
LSPORTS_PREMATCH_MQ_PASSWORD=
LSPORTS_INPLAY_MQ_USERNAME=
LSPORTS_INPLAY_MQ_PASSWORD=
# Compose sets independent regular snapshot caps and a bounded V8 heap.
# This file remains provider credentials/settings only; cutover flags are separate.
